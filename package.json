{
  "name": "@local/dsh-ascii-ocean",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Five whale species with shaded cells or ASCII fill; every content card and the input box is frosted glass with whales blurred behind it, plus independent random dives, tail-stroke ripples, optional input-box avoidance, occasional random spouts, drifting ASCII wind and cloud shadows, continuous toroidal swimming, a whale-size slider, and in-place config updates that never restart the school.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "theme",
    "ui",
    "ascii-art",
    "whale",
    "canvas",
    "frosted-glass"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jryang1997/dsh-ascii-whales.git"
  },
  "homepage": "https://github.com/jryang1997/dsh-ascii-whales#readme",
  "bugs": {
    "url": "https://github.com/jryang1997/dsh-ascii-whales/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "locale/",
    "icon.svg",
    "icon.png",
    "cordis.patch.yml",
    "LICENSE",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "scripts/",
    "preview/",
    "tests/",
    "docs/research/",
    ".node-version",
    "pnpm-workspace.yaml"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node scripts/project-check.mjs test",
    "check": "node scripts/project-check.mjs check",
    "verify": "node scripts/project-check.mjs verify",
    "review:snapshot": "node scripts/review-snapshot.mjs",
    "agent:probe": "node scripts/read-probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
