{
  "name": "@local/dsh-ascii-ocean",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Five whale species with shaded cells or ASCII fill; every content card and the input box is frosted glass with whales blurred behind it, plus independent random dives, tail-stroke ripples, optional input-box avoidance, occasional random spouts, drifting ASCII wind and cloud shadows, continuous toroidal swimming, a whale-size slider, and in-place config updates that never restart the school.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "rig.js",
    "shading.js",
    "motion.js",
    "model.js",
    "surface.js",
    "surface.test.js",
    "ASCII-RENDER-NOTES.md",
    "glass.js",
    "spout.js",
    "engine.js",
    "settings.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "SOURCE-NOTES.md",
    "build.mjs",
    "model.test.js",
    "motion.test.js",
    "regression.test.js",
    "rig.test.js",
    "shading.test.js",
    "overhead.test.js",
    "glass.test.js",
    "content-glass.test.js",
    "update.test.js",
    "spout.test.js",
    "composer.test.js",
    "species.js",
    "species.test.js",
    "WHALE-REFERENCES.md",
    "preview.mjs",
    "whale-preview.html",
    "dive.test.js",
    "random-dive.test.js",
    "water.js",
    "water.test.js",
    "motion-circle.test.js",
    "dive-water.test.js",
    "dive-geometry.test.js",
    "demo-card.test.js",
    "dive-heading.test.js",
    "dive-heading-safety.test.js",
    "atmosphere.js",
    "atmosphere.test.js",
    "ATMOSPHERE-RESEARCH.md",
    "wrap-continuity.test.js",
    "preview-viewport.test.js",
    "reading-layout.js",
    "reading-layout.test.js",
    "simulation.js",
    "simulation.test.js",
    "config-editor.js",
    "config-editor.test.js",
    "browser-build.mjs",
    "browser-build.test.js",
    "artifact-render-harness.js",
    "browser-entry.js",
    "preview-client.js",
    "GLOSSARY.md",
    "scripts/*.mjs",
    "project-check.test.js",
    "review-snapshot.test.js",
    ".node-version",
    "pnpm-workspace.yaml"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/project-check.mjs test",
    "check": "node scripts/project-check.mjs check",
    "verify": "node scripts/project-check.mjs verify",
    "review:snapshot": "node scripts/review-snapshot.mjs",
    "agent:probe": "node scripts/read-probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
