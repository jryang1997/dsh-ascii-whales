{
  "name": "@local/dsh-ascii-ocean",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Five whale species with shaded cells or ASCII fill; every content card and the input box is frosted glass with whales blurred behind it, plus independent random dives, tail-stroke ripples, optional input-box avoidance, occasional random spouts, drifting ASCII wind and cloud shadows, continuous toroidal swimming, a whale-size slider, and in-place config updates that never restart the school.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "theme",
    "ui",
    "ascii-art",
    "whale",
    "canvas",
    "frosted-glass"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jryang1997/dsh-ascii-whales.git"
  },
  "homepage": "https://github.com/jryang1997/dsh-ascii-whales#readme",
  "bugs": {
    "url": "https://github.com/jryang1997/dsh-ascii-whales/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "locale/",
    "icon.svg",
    "icon.png",
    "cordis.patch.yml",
    "LICENSE",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "docs/images/",
    "docs/research/"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "dsh-plugin-kit test",
    "check": "dsh-plugin-kit check",
    "verify": "dsh-plugin-kit verify",
    "review:snapshot": "dsh-plugin-kit review",
    "agent:probe": "dsh-plugin-kit probe AGENTS.md src/engine.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "@jryang1997/dsh-plugin-kit": "https://codeload.github.com/jryang1997/dsh-plugin-kit/tar.gz/refs/tags/v1.0.0",
    "esbuild": "0.28.2"
  },
  "dshPluginKit": {
    "version": 1,
    "dshRulesVersion": "installed-2026-10-23",
    "sources": {
      "mode": "json"
    },
    "tests": {
      "include": [
        "*.test.js",
        "*.test.mjs"
      ],
      "runner": "auto"
    },
    "artifacts": [
      {
        "file": "client.js",
        "produce": "scripts/build.mjs"
      },
      {
        "file": "preview/whale-preview.html",
        "produce": "scripts/preview.mjs"
      }
    ],
    "pack": {
      "forbid": [
        "tests/",
        "scripts/",
        "preview/",
        ".github/",
        ".node-version",
        "pnpm-workspace.yaml",
        "docs/specs/",
        "docs/agents/",
        ".scratch/",
        ".agents/"
      ],
      "require": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "locale/en.json",
        "locale/zh.json",
        "docs/images/"
      ]
    },
    "icon": {
      "declaration": "exports",
      "budgetBytes": 262144
    },
    "locale": {
      "required": [
        "en",
        "zh"
      ],
      "metadata": [
        "title",
        "description"
      ]
    },
    "readme": {
      "files": [
        "README.md",
        "README.en.md"
      ],
      "parity": [
        "headings",
        "figures"
      ]
    },
    "screenshots": {
      "manifest": "screenshots.json",
      "strict": false
    },
    "versionSites": [
      {
        "file": "CHANGELOG.md",
        "pattern": "当前版本 \\*\\*([0-9.]+)\\*\\*"
      }
    ],
    "review": {
      "generated": [
        "client.js",
        "preview/whale-preview.html"
      ]
    }
  }
}
